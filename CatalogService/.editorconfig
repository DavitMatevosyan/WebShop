root = true

[*.cs]
# Use UTF-8 encoding
charset = utf-8

# Indentation
indent_style = space
indent_size = 4

# Line endings
end_of_line = crlf

# dont add new line at the end
insert_final_newline = false 

# Trim whitespace
trim_trailing_whitespace = true

# order by system directive first and in a single group
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# private fields camel casing
dotnet_naming_rule.private_fields_should_be_camel_case.severity = warning
dotnet_naming_rule.private_fields_should_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case.style = camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers = readonly

dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.camel_case.required_prefix = _

# remove this. if not necessary
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# remove braces for simple statements
csharp_prefer_braces = false:warning

# use explicit type for primitive types
csharp_style_var_for_built_in_types = false:warning

# use explicit type when type is easily understandable (var x = new Person())
csharp_style_var_when_type_is_apparent = true:warning

# use var for all cases
csharp_style_var_elsewhere = true:warning

# prefer default over default(int) 
csharp_prefer_simple_default_expression = true:warning

